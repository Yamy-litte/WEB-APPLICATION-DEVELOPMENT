@{
    ViewBag.Title = "Access Denied";
    string role = Convert.ToString(Session["Role"]);
}

<div class="container py-5 text-center">
    <div class="bg-white p-5 rounded shadow-sm">
        <h2 class="mb-3">Access Denied</h2>
        <p class="text-muted mb-4">You do not have permission to access this page.</p>

        @if (string.Equals(role, "Customer", System.StringComparison.OrdinalIgnoreCase))
        {
            <a href="@Url.RouteUrl("CustomerHome")" class="btn btn-primary">Back to Customer Home</a>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Go to Login</a>
        }
    </div>
</div>
