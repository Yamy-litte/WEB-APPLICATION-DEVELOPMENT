@using System.Linq
@model IEnumerable<RestaurantWebsite.Models.Review>

@{
    ViewBag.Title = "My Reviews";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">

        <div class="heading_container heading_center mb-4">
            <h2>My Reviews</h2>
            <p class="text-muted">
                Your dish reviews and order reviews
            </p>
        </div>

        @if (TempData["ReviewSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["ReviewSuccess"]
            </div>
        }

        @if (Model != null && Model.Any())
        {
            foreach (var review in Model)
            {
                <div class="bg-white rounded shadow-sm p-4 mb-4">

                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <h5 class="font-weight-bold mb-1">
                                @(review.Dish != null
                                    ? "Dish Review: " + review.Dish.Name
                                    : "Order Review #" + review.OrderId)
                            </h5>

                            <span class="text-muted">
                                Order #@review.OrderId
                            </span>
                        </div>

                        <small class="text-muted">
                            @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <div class="review-display-stars mt-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fa @(i <= review.Rating ? "fa-star text-warning" : "fa-star-o text-muted")"></i>
                        }
                    </div>

                    <p class="mt-3 mb-2">
                        @(string.IsNullOrWhiteSpace(review.Comment)
                            ? "No comment provided."
                            : review.Comment)
                    </p>

                    @if (!string.IsNullOrWhiteSpace(review.RestaurantReply))
                    {
                        <div class="mt-3 p-3 border-left border-warning bg-light">
                            <strong>Restaurant Response</strong>
                            <p class="mb-1 mt-2">@review.RestaurantReply</p>
                            @if (review.RestaurantReplyAt.HasValue)
                            {
                                <small class="text-muted">
                                    @review.RestaurantReplyAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            }
                        </div>
                    }

                    <div class="mt-4">
                        <a href="@Url.Action("EditReview", "Account", new { id = review.Id })"
                           class="btn btn-sm btn-outline-warning mr-2">
                            <i class="fa fa-edit"></i> Edit
                        </a>

                        @using (Html.BeginForm("DeleteReview", "Account", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete this review?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash"></i> Delete
                            </button>
                        }
                    </div>

                </div>
            }
        }
        else
        {
            <div class="alert alert-light border text-center">
                You have not submitted any reviews yet.
            </div>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action("Profile", "Account")"
               class="btn btn-outline-secondary">
                Back to Profile
            </a>
        </div>

    </div>
</section>
