﻿@using System.Linq
@model IEnumerable<RestaurantWebsite.Models.Order>

@{
    ViewBag.Title = "My Orders";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>My Orders</h2>
        </div>

        @if (TempData["OrderSuccess"] != null)
        {
            <div class="alert alert-success mt-4">@TempData["OrderSuccess"]</div>
        }
        @if (TempData["OrderError"] != null)
        {
            <div class="alert alert-danger mt-4">@TempData["OrderError"]</div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive mt-4">
                <table class="table table-bordered bg-white">
                    <thead class="thead-dark">
                        <tr>
                            <th>Order</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.OrderType</td>
                                <td><span class="badge badge-info order-status-badge">@order.Status</span></td>
                                <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-sm btn-outline-warning mr-1">View Details</a>
                                    @if (order.Status == "Pending")
                                    {
                                        using (Html.BeginForm("Cancel", "Order", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Cancel this order?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light border mt-4 text-center">
                You do not have any orders yet.
            </div>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary">Back to Profile</a>
        </div>
    </div>
</section>
