@using System.Linq
@model RestaurantWebsite.Models.Dish

@{
    Layout = null;

    var primaryImage = Model != null && Model.DishImages != null
        ? Model.DishImages.FirstOrDefault(i => i.IsPrimary) ?? Model.DishImages.FirstOrDefault()
        : null;

    bool isLoggedIn = Session["UserId"] != null;
    var reviews = ViewBag.DishReviews as IEnumerable<RestaurantWebsite.Models.Review>
        ?? new List<RestaurantWebsite.Models.Review>();
    int reviewCount = ViewBag.DishReviewCount != null ? (int)ViewBag.DishReviewCount : 0;
    double averageRating = ViewBag.DishAverageRating != null ? (double)ViewBag.DishAverageRating : 0d;
    bool canReview = ViewBag.CanReview != null && (bool)ViewBag.CanReview;
}

@if (Model == null)
{
    <div class="text-center p-4"><p class="text-danger">Dish information cannot be found.</p></div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="img-box text-center p-2 bg-light rounded">
                @if (primaryImage != null && !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                {
                    <img src="@Url.Content(primaryImage.ImageUrl)" id="mainModalImg" alt="@Model.Name" class="img-fluid rounded" style="max-height:300px;width:100%;object-fit:cover;" />
                }
                else
                {
                    <img src="@Url.Content("~/Resources/User/images/f1.png")" id="mainModalImg" alt="Default" class="img-fluid rounded" style="max-height:300px;width:100%;object-fit:cover;" />
                }
            </div>

            @if (Model.DishImages != null && Model.DishImages.Count() > 1)
            {
                <div class="row mt-2 justify-content-center">
                    @foreach (var img in Model.DishImages)
                    {
                        if (!string.IsNullOrWhiteSpace(img.ImageUrl))
                        {
                            <div class="col-3 p-1">
                                <img src="@Url.Content(img.ImageUrl)" class="img-thumbnail" style="height:50px;width:100%;object-fit:cover;cursor:pointer;" onclick="document.getElementById('mainModalImg').src=this.src" alt="@Model.Name" />
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h3 class="text-dark font-weight-bold">@Model.Name</h3>
            <h4 class="text-danger font-weight-bold my-3">@Model.Price.ToString("N0") VND</h4>
            <p class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available." : Model.Description)</p>

            <div class="mt-3" style="font-size:14px;">
                <p class="mb-1">Category: <span class="badge badge-info">@(Model.Category != null ? Model.Category.Name : "General")</span></p>
                <p class="mb-1">Preparation: <strong>@Model.PreparationTime mins</strong></p>
                <p class="mb-3">Status: <strong class="@(Model.Status == "Available" ? "text-success" : "text-muted")">@Model.Status</strong></p>
            </div>

            @if (Model.Status == "Available")
            {
                if (isLoggedIn)
                {
                    using (Html.BeginForm("AddToCart", "Menu", FormMethod.Post, new { id = "addToCartFromDetails" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="form-group mb-3">
                            <label class="text-secondary">Quantity</label>
                            <div class="d-flex align-items-center" style="max-width:220px;">
                                <button type="button" class="btn btn-outline-secondary" onclick="var i=document.getElementById('txtQuantity');var v=parseInt(i.value)||1;if(v>1)i.value=v-1;">−</button>
                                <input type="text" id="txtQuantity" name="quantity" value="1" readonly class="form-control text-center mx-2" style="width:80px;" />
                                <button type="button" class="btn btn-outline-secondary" onclick="var i=document.getElementById('txtQuantity');var v=parseInt(i.value)||1;if(v<100)i.value=v+1;">+</button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning btn-block text-white font-weight-bold"> <i class="fa fa-shopping-cart"></i> Add to Cart</button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Menu") })" class="btn btn-warning btn-block text-white font-weight-bold">Login to Order</a>
                }
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-block" disabled>Temporarily Unavailable</button>
            }
        </div>
    </div>

    <div class="mt-4 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="font-weight-bold mb-1">Customer Reviews</h4>
                @if (reviewCount > 0)
                {
                    <div>
                        @{
                            double normalized = Math.Round(averageRating * 2, MidpointRounding.AwayFromZero) / 2d;
                            int fullStars = (int)Math.Floor(normalized);
                            bool halfStar = normalized - fullStars >= 0.5d;
                        }
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= fullStars)
                            {
                                <i class="fa fa-star text-warning"></i>
                            }
                            else if (i == fullStars + 1 && halfStar)
                            {
                                <i class="fa fa-star-half-o text-warning"></i>
                            }
                            else
                            {
                                <i class="fa fa-star-o text-muted"></i>
                            }
                        }
                        <strong class="ml-2">@averageRating.ToString("0.0")</strong>
                        <span class="text-muted ml-1">(@reviewCount review@(reviewCount == 1 ? "" : "s"))</span>
                    </div>
                }
                else
                {
                    <span class="text-muted">No reviews yet.</span>
                }
            </div>
        </div>

        @if (!isLoggedIn)
        {
            <div class="alert alert-light border mt-3 mb-3">
                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Menu") })">Log in</a> to write a review.
            </div>
        }
        else if (canReview )
        {
            <div class="card bg-light border-0 mt-3">
                <div class="card-body">
                    <h5 class="font-weight-bold">Write a Review</h5>
                    <form id="reviewForm" action="@Url.Action("AddReview", "Menu")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="dishId" value="@Model.Id" />
                        <div class="form-group">
                            <label>Rating</label>
                            <div class="review-rating-selector" data-current-rating="0">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="review-rating-item" data-rating="@i">
                                        <input type="radio" name="rating" value="@i" />
                                        <i class="fa fa-star-o text-muted"></i>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Comment</label>
                            <textarea name="comment" class="form-control" rows="3" maxlength="1000" placeholder="Share your experience with this dish..."></textarea>
                        </div>
                        <div id="reviewMessage"></div>
                        <button type="submit" class="btn btn-warning text-white">Submit Review</button>
                    </form>
                </div>
            </div>
        }
        else if (isLoggedIn)
        {
            <div class="alert alert-light border mt-3">You have alrealy.</div>
        }

        <div class="mt-4">
            @if (reviews.Any())
            {
                foreach (var review in reviews)
                {
                    <div class="border-bottom pb-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>@(review.User != null ? review.User.FullName : "Customer")</strong>
                                <div class="mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fa @(i <= review.Rating ? "fa-star text-warning" : "fa-star-o text-muted")"></i>
                                    }
                                </div>
                            </div>
                            <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mb-0 mt-2">@review.Comment</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(review.RestaurantReply))
                        {
                            <div class="mt-3 ml-md-4 p-3 border-left border-warning bg-light">
                                <strong>Restaurant Response</strong>
                                <div class="mt-2">@review.RestaurantReply</div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}
