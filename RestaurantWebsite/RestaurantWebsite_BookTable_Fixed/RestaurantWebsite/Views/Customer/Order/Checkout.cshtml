﻿@using System.Collections.Generic
@using System.Linq
@model RestaurantWebsite.Models.Order

@{
    ViewBag.Title = "Checkout";
    ViewBag.BodyClass = "sub_page";

    var dishes = ViewBag.CartDishes as IEnumerable<RestaurantWebsite.Models.Dish>
        ?? new List<RestaurantWebsite.Models.Dish>();
    var quantities = ViewBag.CartQuantities as Dictionary<int, int>
        ?? new Dictionary<int, int>();
    var combos = ViewBag.CartCombos as IEnumerable<RestaurantWebsite.Models.Combo>
        ?? new List<RestaurantWebsite.Models.Combo>();
    var comboQuantities = ViewBag.ComboQuantities as Dictionary<int, int>
        ?? new Dictionary<int, int>();
    var promotions = ViewBag.ActivePromotions as IEnumerable<RestaurantWebsite.Models.Promotion>
        ?? new List<RestaurantWebsite.Models.Promotion>();
    var confirmedReservations = ViewBag.ConfirmedReservations as IEnumerable<RestaurantWebsite.Models.Reservation>
        ?? new List<RestaurantWebsite.Models.Reservation>();

    decimal subTotal = ViewBag.CheckoutSubTotal != null
        ? (decimal)ViewBag.CheckoutSubTotal
        : 0m;

    decimal deliveryFee = ViewBag.DeliveryFee != null
        ? (decimal)ViewBag.DeliveryFee
        : 0m;

    string selectedType = string.IsNullOrWhiteSpace(Model.OrderType)
        ? "Delivery"
        : Model.OrderType;
}

<section class="food_section layout_padding">
    <div class="container">
        <div class="heading_container heading_center mb-4">
            <h2>Checkout</h2>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "Please check the information below:")
            </div>
        }

        <div class="row">
            <div class="col-lg-7">
                <div class="bg-white p-4 rounded shadow-sm mb-4">
                    <div class="heading_container mb-3">
                        <h3>Order Information</h3>
                    </div>

                    @using (Html.BeginForm("PlaceOrder", "Order", FormMethod.Post, new { id = "checkoutForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="OrderType" class="font-weight-bold">Order Type</label>
                            <select id="OrderType" name="OrderType" class="form-control restaurant-select" required title="Select order type">
                                <option value="Dine-in" @(selectedType == "Dine-in" ? "selected=\"selected\"" : "")>Dine-in</option>
                                <option value="Takeaway" @(selectedType == "Takeaway" ? "selected=\"selected\"" : "")>Takeaway</option>
                                <option value="Delivery" @(selectedType == "Delivery" ? "selected=\"selected\"" : "")>Delivery</option>
                            </select>
                            <small class="form-text text-muted">
                                Choose how you want to receive your order.
                            </small>
                        </div>

                        <div class="form-group" id="reservationGroup">
                            <label for="ReservationId" class="font-weight-bold">Confirmed Reservation</label>

                            @if (confirmedReservations.Any())
                            {
                                <select id="ReservationId" name="ReservationId" class="form-control restaurant-select" title="Select a confirmed reservation">
                                    <option value="">-- Select a confirmed reservation --</option>
                                    @foreach (var reservation in confirmedReservations)
                                    {
                                        string reservationLabel =
                                            reservation.ReservationDate.ToString("dd/MM HH:mm") +
                                            " - Table " +
                                            (reservation.Table != null ? reservation.Table.TableNumber : "-") +
                                            " - " + reservation.PartySize + " guests";

                                        <option value="@reservation.Id"
                                                @(Model.ReservationId == reservation.Id ? "selected" : "")>
                                            @reservationLabel
                                        </option>
                                    }
                                </select>
                                <small class="form-text text-muted">
                                    Dine-in orders require a confirmed reservation.
                                </small>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    You do not have a confirmed table reservation. Please book and wait for Staff confirmation first.
                                </div>
                            }

                            @Html.ValidationMessageFor(m => m.ReservationId, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label for="Phone" class="font-weight-bold">Phone Number</label>
                            @Html.TextBoxFor(m => m.Phone, new
                            {
                                @class = "form-control",
                                id = "Phone",
                                maxlength = "20",
                                placeholder = "Your phone number"
                            })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="deliveryAddressGroup">
                            <label for="DeliveryAddress" class="font-weight-bold">Delivery Address</label>
                            @Html.TextAreaFor(m => m.DeliveryAddress, new
                            {
                                @class = "form-control",
                                id = "DeliveryAddress",
                                rows = "3",
                                maxlength = "500",
                                placeholder = "Enter delivery address"
                            })
                            <small class="form-text text-muted">
                                Required only for Delivery orders.
                            </small>
                            @Html.ValidationMessageFor(m => m.DeliveryAddress, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Payment Method</label>
                            <div class="border rounded p-3">
                                <label class="d-block mb-2">
                                    <input type="radio" name="paymentMethod" value="Cash" @(ViewBag.SelectedPaymentMethod == null || ViewBag.SelectedPaymentMethod.ToString() == "Cash" ? "checked=\"checked\"" : "") />
                                    <span class="ml-2">Cash</span>
                                </label>
                                <label class="d-block mb-2">
                                    <input type="radio" name="paymentMethod" value="Bank Transfer" @(ViewBag.SelectedPaymentMethod != null && ViewBag.SelectedPaymentMethod.ToString() == "Bank Transfer" ? "checked=\"checked\"" : "") />
                                    <span class="ml-2">Bank Transfer</span>
                                </label>
                                <label class="d-block mb-0">
                                    <input type="radio" name="paymentMethod" value="Digital Wallet" @(ViewBag.SelectedPaymentMethod != null && ViewBag.SelectedPaymentMethod.ToString() == "Digital Wallet" ? "checked=\"checked\"" : "") />
                                    <span class="ml-2">Digital Wallet</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="promotionCode" class="font-weight-bold">Promotion Code</label>
                            <input type="text"
                                   name="promotionCode"
                                   id="promotionCode"
                                   class="form-control"
                                   maxlength="50"
                                   value="@(ViewBag.EnteredPromotionCode ?? "")"
                                   placeholder="Enter promotion code" />
                            @if (promotions.Any())
                            {
                                <small class="form-text text-muted">
                                    Available codes: @string.Join(", ", promotions.Select(p => p.Code))
                                </small>
                            }
                        </div>

                        <div class="form-group">
                            <label for="Note" class="font-weight-bold">Note</label>
                            @Html.TextAreaFor(m => m.Note, new
                            {
                                @class = "form-control",
                                id = "Note",
                                rows = "3",
                                maxlength = "500",
                                placeholder = "Special instructions for the restaurant"
                            })
                            @Html.ValidationMessageFor(m => m.Note, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="@Url.RouteUrl("CustomerCart")" class="btn btn-outline-secondary">Back to Cart</a>
                            <button type="submit" class="btn btn-warning text-white">Place Order</button>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="bg-white p-4 rounded shadow-sm">
                    <div class="heading_container mb-3">
                        <h3>Order Summary</h3>
                    </div>

                    @foreach (var dish in dishes)
                    {
                        int quantity = quantities.ContainsKey(dish.Id) ? quantities[dish.Id] : 0;
                        decimal subtotal = dish.Price * quantity;
                        string imageUrl = "~/Resources/User/images/f1.png";

                        if (dish.DishImages != null && dish.DishImages.Any())
                        {
                            var primaryImage = dish.DishImages.FirstOrDefault(image => image.IsPrimary)
                                ?? dish.DishImages.First();

                            if (!string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                            {
                                imageUrl = primaryImage.ImageUrl;
                            }
                        }

                        <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                            <img src="@Url.Content(imageUrl)"
                                 alt="@dish.Name"
                                 style="width:65px;height:65px;object-fit:cover;border-radius:8px;"
                                 class="mr-3" />
                            <div class="flex-grow-1">
                                <strong>@dish.Name</strong>
                                <div class="text-muted small">@quantity x @dish.Price.ToString("N0") VNĐ</div>
                            </div>
                            <strong>@subtotal.ToString("N0") VNĐ</strong>
                        </div>
                    }

                    @foreach (var combo in combos)
                    {
                        int quantity = comboQuantities.ContainsKey(combo.Id) ? comboQuantities[combo.Id] : 0;
                        decimal subtotal = combo.Price * quantity;
                        string imageUrl = string.IsNullOrWhiteSpace(combo.ImageUrl)
                            ? "~/Resources/User/images/o2.jpg"
                            : combo.ImageUrl;

                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex align-items-center">
                                <img src="@Url.Content(imageUrl)"
                                     alt="@combo.Name"
                                     style="width:65px;height:65px;object-fit:cover;border-radius:8px;"
                                     class="mr-3" />
                                <div class="flex-grow-1">
                                    <strong>@combo.Name</strong>
                                    <div class="text-muted small">@quantity x @combo.Price.ToString("N0") VNĐ</div>
                                </div>
                                <strong>@subtotal.ToString("N0") VNĐ</strong>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span>
                        <strong>@subTotal.ToString("N0") VNĐ</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Discount</span>
                        <strong>Calculated after applying code</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Delivery Fee</span>
                        <strong>@deliveryFee.ToString("N0") VNĐ</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="font-weight-bold">Total</span>
                        <strong class="text-danger">@subTotal.ToString("N0") VNĐ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
<script>
    $(function () {
        function toggleOrderTypeFields() {
            var type = $("#OrderType").val();
            $("#deliveryAddressGroup").toggle(type === "Delivery");
            $("#reservationGroup").toggle(type === "Dine-in");

            if (type !== "Delivery") {
                $("#DeliveryAddress").val("");
            }
        }

        $("#OrderType").on("change", toggleOrderTypeFields);
        toggleOrderTypeFields();
    });
</script>
}
